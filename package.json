{
  "name": "dark-blue-theme-x",
  "version": "1.0.55",
  "type": "commonjs",
  "private": true,
  "description": "X (Twitter) のダークテーマをDarkBlue(Dim)テーマに変換するブラウザ拡張機能 (Chrome / Firefox)",
  "scripts": {
    "sync:support": "node --preserve-symlinks-main ./node_modules/@kagayoi/support-extension/bin/kagayoi-support-sync.mjs",
    "generate-icons": "node scripts/generate-icons.js",
    "zip:win": "pwsh -NoProfile -ExecutionPolicy Bypass -File zip.ps1",
    "zip:nix": "bash zip.sh",
    "zip": "pnpm run zip:nix",
    "zip:chrome": "bash zip.sh chrome",
    "zip:firefox": "bash zip.sh firefox",
    "zip:both": "bash zip.sh both",
    "check-version": "node scripts/check-version.js",
    "check-shared-literals": "node scripts/check-shared-literals.js",
    "check-support-permissions": "node scripts/check-support-permissions.js",
    "check-theme-state": "node scripts/check-theme-state.js",
    "check": "pnpm run check-version && pnpm run check-shared-literals && pnpm run check-support-permissions && pnpm run check-theme-state"
  },
  "devDependencies": {
    "@kagayoi/support-extension": "1.0.8",
    "chrome-webstore-upload-cli": "4.0.2",
    "sharp": "^0.35.5",
    "web-ext": "10.8.0"
  },
  "license": "MIT"
}
